{
  "name": "smena-driver-diary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/summary.test.ts tests/api.test.ts tests/demo.test.ts",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "preview:demo": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "start": "node dist/server/index.js",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "^1.12.0"
    }
  }
}
